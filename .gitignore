# --- Backend (Model 1, Model 2, Model 3 - Python/FastAPI) ---
model[1-3]/backend/.venv/
model[1-3]/backend/venv/
model[1-3]/backend/.testing/
model[1-3]/backend/**/__pycache__/
model[1-3]/backend/**/*.py[cod]
model[1-3]/backend/.env
model[1-3]/backend/.env.*
!model[1-3]/backend/.env.example

# --- Model 2 specific artifacts (Video/ML storage) ---
model2/backend/media/
model2/backend/anpr_snapshots/
model2/backend/*.pt

# --- Frontend (Model 1, Model 2, Model 3 - React/Vite) ---
model[1-3]/frontend/node_modules/
model[1-3]/frontend/.vite/
model[1-3]/frontend/dist/
model[1-3]/frontend/.env
model[1-3]/frontend/.env.*
!model[1-3]/frontend/.env.example

# --- logs don't need to be pushed ---
logs/

# --- OS / editor noise (repo-wide) ---
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
