# ============================================================================
# SHARED DATABASE & AUTHENTICATION
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost/cctv_db
SECRET_KEY=your-very-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ============================================================================
# SECURITY & TLS
# ============================================================================
ENABLE_HTTPS=false
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ============================================================================
# MODEL 1: CCTV REGISTRY & GIS
# ============================================================================
MODEL1_API_PORT=8000
MODEL1_LOG_LEVEL=INFO

# ============================================================================
# MODEL 2: LIVE FEED RELAY & ANPR
# ============================================================================
MODEL2_API_PORT=8001
MODEL2_LOG_LEVEL=INFO

# Camera feed streaming
MODEL2_FRAME_RATE_TARGET=8
MODEL2_MAX_CONCURRENT_SOURCES=50
MODEL2_RECONNECT_BACKOFF_START=2
MODEL2_RECONNECT_BACKOFF_MAX=30

# ANPR Pipeline
ANPR_YOLO_WEIGHTS=yolov8n.pt
ANPR_CONFIDENCE_THRESHOLD=0.5
ANPR_JOB_QUEUE_WORKERS=2

# Snapshot retention (days)
ANPR_SNAPSHOT_RETENTION_DAYS=30
ANPR_SNAPSHOT_DIR=media/anpr_snapshots

# RTSP Configuration
RTSP_TRANSPORT=tcp
RTSP_CONNECTION_TIMEOUT=10
RTSP_RECONNECT_INTERVAL=5

# ============================================================================
# MODEL 3: VMS FEDERATION & MIDDLEWARE
# ============================================================================
MODEL3_API_PORT=8002
MODEL3_LOG_LEVEL=INFO

# Model 1 service account (for federation)
MODEL1_SERVICE_USERNAME=model3_service
MODEL1_SERVICE_PASSWORD=change-me-in-production
MODEL1_SERVICE_ENDPOINT=http://localhost:8000

# Model 2 viewer endpoint (for federation)
MODEL2_VIEWER_BASE=http://localhost:8001/api/v2

# ============================================================================
# AUDIT & MONITORING
# ============================================================================
AUDIT_LOG_DIR=logs
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_PORT=9090

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
DEBUG=false
