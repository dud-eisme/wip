# PostgreSQL connection (must have PostGIS available on the server)
DATABASE_URL=postgresql+psycopg2://cctv_user:cctv_pass@localhost:5432/cctv_registry

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Vendor webhook API key(s), comma-separated. Each external vendor system
# should be issued its own key and mapped to a department below.
VENDOR_API_KEYS=vendor-key-police-001:Police,vendor-key-transport-001:Transport
