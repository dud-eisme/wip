# IMPORTANT: point this at the SAME database Model 1 uses, so Model 2 can
# read the existing `users` table (shared login) and `cameras` table
# (Sources registry links back to cameras.id).
DATABASE_URL=postgresql://anpr_worker:password@localhost:5432/cctv_registry

# IMPORTANT: use the EXACT SAME SECRET_KEY as Model 1's .env.
# JWT tokens are signed with this key — if it differs, a token issued by
# Model 1's /login will be rejected here, and vice versa.
ALGORITHM=RS256
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAv/54oAm0XKGSsSr9plu3\nSrS7PMrQspnj+VUUZi5YogQ/9evluZqaLMJV7qEmJa4vrZVwHxxiUhGPRsrLTEpW\no19cQbCqFmMxvOL8eEHowkWy+qQoVbJvvwQgBjZZI0Bf76iGgUiSX0GVrP+RxuJE\nxbWhsm9yHjHUGwDzP4k+zirgr6OSff01u+xFnnlybcGFr93cklEb9jqBxYw0Dcz6\nD9SAVJHyfnnUnwhM8M+459dAIso1miJE5hUfD8mfh1qzOQfwSfBxpVhUHUTJgacq\nvbYrmXZaDTSjHCx8qk6pxQqtcoJmKYaVOZ2pnECJu/ek2Kaoyg99vneX/nbaNanv\nVwIDAQAB\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Feed relay tuning ---
# Max frames per second the relay re-encodes/serves per camera. Lower this
# to reduce CPU load when running many cameras at once.
STREAM_TARGET_FPS=8
# How many camera worker threads are allowed to run concurrently.
# 50 is supported functionally, but real CPU/bandwidth cost depends on
# resolution and source count — see README "Can it really handle 50 cameras?"
MAX_CONCURRENT_SOURCES=50

# --- File storage (ANPR detection snapshots) ---
# Where cropped-plate images are saved, organized as:
#   <STORAGE_ROOT>/anpr_snapshots/<camera_id>/<date>/<event_id>.jpg
STORAGE_ROOT=./media

# --- ANPR pipeline ---
# Process every Nth frame instead of every frame (heavy speed/accuracy tradeoff)
ANPR_FRAME_SKIP=5

# Plate-format sanity check (cheaply filters OCR garbage). Set false to log
# everything OCR returns, e.g. while debugging a new detector/OCR backend.
ANPR_VALIDATE_INDIAN_FORMAT=true

# --- ANPR detector backend ---
# "yolo" (default): ultralytics.YOLO(ANPR_YOLO_WEIGHTS).
# "indian_lpr_fcos": the vendored FCOS+HRNet detector from
# sanchit2843/Indian_LPR (indian_lpr_fcos/ package) — needs
# ANPR_FCOS_WEIGHTS below and `pip install torch torchvision pyyaml`.
ANPR_DETECTOR_BACKEND=yolo

# Used when ANPR_DETECTOR_BACKEND=yolo.
# A general yolov8n.pt will run but won't detect plates specifically — for
# real plate detection you need weights trained on a license-plate dataset.
# Leave default to test wiring.
ANPR_YOLO_WEIGHTS=/home/joe/.cache/huggingface/hub/models--Koushim--yolov8-license-plate-detection/snapshots/9aaa5cd490abe0c165882ba87f4f62658ab54d01/best.pt

# Used when ANPR_DETECTOR_BACKEND=indian_lpr_fcos. Point at Indian_LPR's
# best_od.pth (or your own FCOS+HRNet checkpoint trained the same way).
ANPR_FCOS_WEIGHTS=./weights/best_od.pth
# Optional tuning — defaults shown, uncomment to override:
# ANPR_FCOS_SCORE_THRESHOLD=0.3
# ANPR_FCOS_NMS_IOU=0.2

# --- ANPR OCR backend ---
# "easyocr" (default) | "paddleocr" | "lprnet"
# lprnet is the vendored Indian_LPR OCR model (lprnet_ocr/ package) —
# needs ANPR_LPRNET_WEIGHTS below and `pip install torch`.
ANPR_OCR_BACKEND=easyocr

# Used when ANPR_OCR_BACKEND=lprnet. Point at Indian_LPR's
# best_lprnet.pth (or your own LPRNet checkpoint).
ANPR_LPRNET_WEIGHTS=./weights/best_lprnet.pth
# Optional tuning — default shown, uncomment to override:
# ANPR_LPRNET_MAX_LEN=18

# --- ANPR CCTV-accuracy tweaks (see README §6a) ---
ANPR_OCR_GPU=true

ENABLE_HTTPS=true
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem
