# URLs of the two systems this middleware federates
MODEL1_REGISTRY_BASE=http://localhost:8000/api/v1
MODEL2_VIEWER_BASE=http://localhost:8001/api/v2

# Model 3 authenticates to Model 1 as a service account (not an end user).
# This account must already exist in Model 1's database — register it there
# first via /docs, then put its credentials here.
MODEL1_SERVICE_EMAIL=user@example.com
MODEL1_SERVICE_PASSWORD=password

# How long to trust a cached Model 1 token before re-authenticating (seconds)
MODEL1_TOKEN_CACHE_SECONDS=1800

# How long to wait for each upstream call before treating that adapter as
# unreachable (seconds) — keeps one dead adapter from hanging the whole
# federated request.
ADAPTER_TIMEOUT_SECONDS=5
